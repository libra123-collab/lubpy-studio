# Gemini API Key (Server-side)
GEMINI_API_KEY=

# Cloud SQL Database Configuration (Server-side runtime)
DATABASE_URL=
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=
SQL_PORT=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Session & JWT Secret (Mandatory for secure production authentication)
JWT_SECRET=
SESSION_SECRET=
ADMIN_SECURITY_KEY=

# Firebase Cloud Messaging (FCM) Configuration for Push Notifications (Mobile & Web)
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Node Environment
NODE_ENV=development
PORT=3000
